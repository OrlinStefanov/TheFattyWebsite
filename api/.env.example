# Copy this file to api/.env and fill in the values. Never put real values in this file: it is committed.
NODE_ENV=development
PORT=3000

# Exact origin of the static site (no path, no trailing slash).
ALLOWED_ORIGIN=https://orlinstefanov.github.io

# Supabase: Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# "service_role" key (secret). Server-side only. Never in the frontend or the repo.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase "anon" / "publishable" key (public by design). Used by the API to sign admins in.
SUPABASE_ANON_KEY=

# Public origin of this API: admin pages and session cookies live here. Defaults to http://localhost:PORT.
# Required (https) in production.
# PUBLIC_URL=https://thefatty-api.onrender.com

# Reverse proxies in front of the API (Render adds one). Do not raise it without checking: a wrong
# value lets clients forge their IP, or hides the real one.
# TRUST_PROXY_HOPS=1

# Secret for hashing visitor IPs (never stored raw). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SECRET=

# Cloudflare R2 (used by `npm run release` / update-apk.sh)
# Dashboard -> R2 -> Overview, right side: Account ID
R2_ACCOUNT_ID=
# R2 -> Manage API tokens -> Create API token -> Object Read & Write, limited to your bucket
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket name
R2_BUCKET=
# Bucket -> Settings -> Public access -> enable the r2.dev subdomain. No trailing slash.
R2_PUBLIC_URL=https://pub-xxxx.r2.dev
